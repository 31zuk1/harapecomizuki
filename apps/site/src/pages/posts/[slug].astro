---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPostBySlug, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const resolvedPost = getPublishedPostBySlug(post.slug) ?? post;
const Content = resolvedPost.Content as unknown as (...args: never[]) => unknown;
---

<BaseLayout title={`${post.data.title} | Discord Blog PoC`}>
  <article class="article">
    <p class="article-meta">
      <span>{post.data.authorName}</span>
      <span>{new Date(post.data.publishedAt ?? post.data.draftUpdatedAt).toLocaleString('ja-JP')}</span>
    </p>
    <h1>{post.data.title}</h1>

    {post.data.tags.length > 0 && (
      <ul class="tags">
        {post.data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )}

    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>
