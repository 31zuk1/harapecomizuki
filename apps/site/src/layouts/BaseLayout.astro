---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = 'Discord から更新できる Discord-first publishing demo',
  currentPath = ''
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="backdrop">
      <div class="orb orb-a"></div>
      <div class="orb orb-b"></div>
      <div class="orb orb-c"></div>
    </div>
    <div class="shell">
      <header class="site-header">
        <div>
          <a class="brand" href={basePath}>Harapecomizuki</a>
          <p class="tagline">Discord-driven publishing workflow for a static engineering blog</p>
        </div>
        <nav class="site-nav" aria-label="Primary">
          <a class:list={['nav-link', currentPath === '/' && 'is-active']} href={basePath}>Home</a>
          <a class="nav-link" href={`${basePath}#graph-view`}>Graph</a>
          <a class="nav-link" href={`${basePath}#site-search`}>Search</a>
          <a class="nav-link nav-link-secondary" href="https://github.com/31zuk1/harapecomizuki">GitHub</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>Discord-first workflow, static publishing, human-friendly beta.</p>
      </footer>
    </div>
  </body>
</html>
